# SPDX-License-Identifier: MIT

# Sign images with the project's key, an ECDSA P-256 private key in PEM format.
# It is taken from the MCUBOOT_SIGNING_KEY environment variable (a path) or,
# when that is not set, from its usual place in the home directory. With
# neither, the build falls back to MCUboot's public development key.
PROJECT_KEY := $(shell,ls ~/.mcuboot/xiao-nrf52840-sense-plus.pem 2>/dev/null)

config BOOT_SIGNATURE_KEY_FILE
	default "$(MCUBOOT_SIGNING_KEY)" if "$(MCUBOOT_SIGNING_KEY)" != ""
	default "$(PROJECT_KEY)" if "$(PROJECT_KEY)" != ""

source "share/sysbuild/Kconfig"
